# research-engine — copie para .env (dev local). No compose da beta as vars vêm do .env da raiz.

# ── Backend do Gemini: Vertex OU API key ─────────────────────────────────────
# Vertex (produção): service account em GOOGLE_CREDENTIALS (JSON) ou ADC (GOOGLE_APPLICATION_CREDENTIALS).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=            # fallback: GOOGLE_PROJECT_ID, depois project_id do GOOGLE_CREDENTIALS
GOOGLE_CLOUD_LOCATION=global     # fallback: GEMINI_TEXT_LOCATION, GOOGLE_LOCATION; padrão "global"
# GOOGLE_CREDENTIALS={"type":"service_account",...}
# API key (dev): usada quando GOOGLE_GENAI_USE_VERTEXAI não é true. Fallback: GOOGLE_API_KEY.
GEMINI_API_KEY=

# ── Modelo e limites ─────────────────────────────────────────────────────────
RESEARCH_ENGINE_MODEL=gemini-3.5-flash
RESEARCH_ENGINE_TIMEOUT_MS=25000        # teto de UMA chamada ao Gemini
RESEARCH_ENGINE_PRAZO_MS=30000          # prazo total do /suggest e /refresh
RESEARCH_ENGINE_MAX_RETRIES=2           # retentativas além da 1ª (teto duro 2)
RESEARCH_ENGINE_BACKOFF_BASE_MS=500     # backoff = base·2^n + jitter[0, base]
RESEARCH_ENGINE_MAX_OUTPUT_TOKENS=8192
RESEARCH_ENGINE_THINKING_LEVEL=         # vazio = default do modelo; ex.: low

# ── Auth opcional do /motor/v1 e /suggest (vazio = aberto; só use aberto em rede interna) ──
MOTOR_TOKEN=
