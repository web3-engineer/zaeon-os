// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // native = máquina de build (dev/CI). Os alvos Debian cobrem o container do VPS
  // (gera o engine pra openssl 1.1 e 3.0 → não dá "could not locate Query Engine").
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

// --- MODELO DE USUÁRIO ---
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?   
  
  // Profile
  course          String?   
  bio             String?   
  age             Int?
  gender          String?
  countryCode         String?
  city                String?
  onboardingComplete  Boolean   @default(false)
  tourDone            Boolean   @default(false)   // tour guiado da Zaeon (onboarding) — visível no dashboard
  cyberNasceuEm       DateTime? // 1ª entrada no CYBERESPAÇO: vazio = nunca entrou → nasce num tubo de ensaio (lib/cyber/onboarding)
  cyberPerfil         Json?     // o que a pessoa contou pra Zaeon na capela (nome, situação, área, foco, o que quer estudar, objetivo — lib/cyber/conversaZaeon): memória dos agentes e base da gamificação
  cyberExpulsoEm      DateTime? // a última vez que o Droid expulsou a pessoa do cyberespaço (desrespeitou a Zaeon)
  torsoImage          String?
  role                String?
  phone               String?   
  
  // Gamification & Skill Tree
  level           Int       @default(1)   // derivado do saldo AURA (lib/aura/rules.ts) quando AURA_ECONOMY liga
  streak          Int       @default(0)
  xp              Int       @default(0)   // DEPRECADO: migrado pro ledger (AuraEvent legacy_xp); não escrever mais
  aura            Int       @default(0)   // cache do saldo AURA — a verdade é o ledger (AuraEvent), recomputável
  verificadorHabilitado Boolean @default(false) // professor/instituição que pode chancelar credenciais acadêmicas
  skills          Json?     // <--- NOVO: O motor do RPG acadêmico (Ranks F-SS)
  
  // Projetos IDE (agentic) — per-user GitHub App installation
  githubInstallationId String?  // overrides GITHUB_APP_INSTALLATION_ID when the student installs the App on their own repos
  githubDefaultRepo    String?  // "owner/name" the IDE opens by default
  // GitHub OAuth user-to-server (modelo "conta pessoal do aluno"): cria/edita repos NA CONTA dele
  githubUserToken      String?  // user-to-server access token (CIFRADO via lib/projects/crypto)
  githubUserLogin      String?  // login do GitHub do aluno
  githubRefreshToken   String?  // refresh token (CIFRADO) quando o App usa tokens expiráveis
  githubTokenExpiresAt DateTime?

  // Identity
  identityId      String?
  idType          String?
  walletAddress   String?
  // Credenciais Solana (ver lib/solana/credentials.ts): cache do endereço da wallet CUSTODIAL
  // criada pela Crossmint no 1º LOGIN (src/lib/auth.ts → events.createUser) ou, se ela não
  // existir ainda, no 1º mint (email:<aluno>:solana). O aluno nunca vê seed phrase/gas.
  solanaWallet    String?
  solanaWalletAt  DateTime?   // quando a wallet foi provisionada (diagnóstico do 1º login)
  
  // Admin & Verification
  kycStatus         String  @default("pending")
  academicLevel     String  @default("Graduação") // <--- NOVO: Graduação, Mestrado, Doutorado... (Definido pelo Admin)
  documents         Json?
  institution       String?
  verificationDoc   String?

  // Planos / trial de estudante (ver lib/plans.ts + /api/trial/*)
  plan            String?   @default("free")  // "free" | "plus"
  // Mentor ativo no chat (MentorTemplate.id); null = Aura base. Ver /api/mentors/activate.
  activeMentorId  String?   @db.ObjectId
  plusUntil       DateTime?
  trialGranted    Boolean   @default(false)
  eduEmail        String?
  eduVerified     Boolean   @default(false)

  // Capacidades premium liberadas pelo admin (gating)
  deepThinkEnabled     Boolean  @default(false)  // Modo Econômico: deep-thinking (Gemini Pro) — override avulso do admin
  advancedVoiceEnabled Boolean  @default(false)  // Modo Voz Avançado — override avulso do admin
  projectsEnabled      Boolean  @default(false)  // aba Projetos (Zaeon Code) liberada avulso pelo admin
  voicePref            Json?    // { gender: 'f'|'m', voiceId, autoRead }
  deepThinkUsedAt      DateTime? // último uso do profundo (cota diária do Pulse)

  // Invite system
  referredBy      String?  @db.ObjectId  // bare ObjectId — no Prisma relation (avoids circular User→User FK, populated in application layer)
  // NÃO @unique: o código é atribuído de forma LAZY (signup deixa null; /api/convite/meu-codigo
  // preenche na 1ª visita) → muitos users têm null, e um índice unique SIMPLES rejeita nulls
  // repetidos (E11000 no db push). A unicidade real vem de InviteCode.code (retry no app). Para
  // reforçar no banco, crie um índice PARCIAL no Atlas (unique só entre os atribuídos):
  //   db.users.createIndex({ myInviteCode: 1 }, { unique: true, partialFilterExpression: { myInviteCode: { $type: "string" } } })
  myInviteCode    String?
  inviteCodeUsed  String?              // denormalized audit: the human-readable code string (e.g. "ZA3K-X9QM")
  subject         String?

  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt

  // Relations Base
  accounts         Account[]
  sessions         Session[]
  posts            Post[]
  comments         Comment[]
  userSpaceData    UserSpaceData?
  personalPhotos   PersonalPhoto[] // 🔥 NOVO: Relação com as fotos do Mural (My Photos)

  // Relations de Chat e Rede
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  sentRequests     ConnectionRequest[] @relation("SentRequests")
  receivedRequests ConnectionRequest[] @relation("ReceivedRequests")

  // 🔥 NOVO: Relações Professor-Aluno
  teacherStudents  TeacherStudent[] @relation("TeacherStudents")  // Alunos deste professor
  studentOf        TeacherStudent[] @relation("StudentOf")        // Professores deste aluno

  // 🔥 NOVO: Documentos do Professor (Tarefas e Provas)
  teacherDocuments TeacherDocument[] @relation("TeacherDocuments")

  // 🔥 NOVO (Phase 2 — Provas gateway): submissões do aluno
  studentSubmissions ExamSubmission[] @relation("StudentSubmissions")

  // 🔥 NOVO: Links de convite gerados
  teacherLinks     ClassLink[] @relation("TeacherLinks")

  ownedInviteCodes InviteCode[] @relation("OwnedInviteCodes")

  // 🔥 CRÍTICO: Sincroniza o Prisma com o NextAuth (coleção 'users')
  @@map("users") 
}

// --- NOVO: LINKS DE CONVITE DO PROFESSOR ---
model ClassLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  teacherId String   @db.ObjectId
  subject   String
  room      String   // Ex: 'cyber', 'med'
  location  String?  // Ex: Sala 1B, Meet link
  hour      Int?
  endHour   Int?
  days      Int[]    @default([])
  createdAt DateTime @default(now())
  
  teacher   User     @relation("TeacherLinks", fields: [teacherId], references: [id])
}

// --- SISTEMA DE CONVITES ---
model InviteCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  ownerId   String?  @db.ObjectId
  owner     User?    @relation("OwnedInviteCodes", fields: [ownerId], references: [id])
  usedCount Int      @default(0)
  maxUses   Int      @default(3)
  createdAt DateTime @default(now())

  @@map("invite_codes")
}

model PendingRegistration {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken    String   @unique
  inviteCode      String
  name            String   @default("")
  age             Int      @default(0)
  area            String   @default("")
  role            String   @default("")
  subject         String?
  institution     String   @default("")
  gender          String?  // 'f' | 'm' — escolhido no card de convite (boas-vindas gendered)
  verificationDoc String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@map("pending_registrations")
}

// --- MEMÓRIA DO LOUNGE & SALAS ---
model UserSpaceData {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Base UI
  layout          Json?    // Armazena janelas abertas e posições
  settings        Json?    // Armazena tema e preferências
  
  // State Persistence
  layoutState       Json?    
  schedule          Json?    
  stickyNote        String?  
  
  // Modules & History
  chatHistory       Json?    
  zaeonChat         Json?    
  library           Json?    
  fabricator        Json?    
  personalModules   Json?    

  // Profile & Objectives
  objectives        Json?    

  // Legacy/Work
  activeProject     Json?    
  citations         Json?    
  workContent       String?  
  workTitle         String?  

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt 
}

model SystemSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique 
  value     String   
  updatedAt DateTime @updatedAt
}

// --- MODELO POST ATUALIZADO (NEURAL EDITOR) ---
model Post {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String?
  subtitle    String?
  content     String
  tags        String[] @default([])
  images      String[] @default([]) // Máximo 5 pelo front
  attachments Json?    // Links ou Docs
  likes       String[] @default([]) 
  createdAt   DateTime @default(now())
  room        String   @default("cyber") 
  user        String   
  userImage   String?  
  userId      String?  @db.ObjectId
  author      User?    @relation(fields: [userId], references: [id])
  comments    Comment[]
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  user      String   
  createdAt DateTime @default(now())
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?  @db.ObjectId
  author    User?    @relation(fields: [userId], references: [id])
}

model NewsPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       Json
  subtitle    Json?
  content     Json
  imageUrl    String?
  publishDate DateTime @default(now())
  status      String   @default("draft")
  category    String   @default("news") 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- NOVO MODELO DE PLUGINS (GAMIFIED STORE) ---
model Plugin {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  author            String   @default("Zaeon Core")
  description       String
  category          String   // Essencial, Agentes, Mentores
  tag               String?  // Livre, Alunos, VIP
  imageUrl          String?  // capa do plugin (URL); fallback p/ ícone por categoria
  price             Float    @default(0)
  actionUrl         String
  isLocked          Boolean  @default(false)
  unlockRequirement String?  // Ex: "Nível 5 necessário"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // --- Envelope Agent Skills (PASSO 9 · spec agentskills.io + Zaeon). Aditivo/nullable p/ não
  // quebrar linhas/uso existentes; o rename model Plugin→Skill (@@map) é o PR de UI separado. ---
  slug          String?   // spec name: ^[a-z0-9]+(-[a-z0-9]+)*$ (unicidade validada no app)
  license       String?
  compatibility String?
  allowedTools  String[]  // tools que a skill pode chamar
  runtime       String?   // "ts" | "python" | "mcp"
  risk          String?   // read | write | destructive
  minPlan       String?   // gate por plano (9.10)
  tier          String?   // T0..T3
  courseTags    String[]
  defaultOn     Boolean?  // liga por padrão (por fase)
  sourceRepo    String?
  sourceSha     String?
  autoAuthored  Boolean?  // F4: destilada de uma trajetória aprovada (só o contrato agora)
  metadata      Json?     // version em metadata.version; extras exportáveis em metadata.zaeon-*
}

model Account {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  userId             String  @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.String
  access_token       String? @db.String
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.String
  session_state      String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])

  // 🔥 CRÍTICO: Sincroniza o Prisma com o NextAuth (coleção 'accounts')
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 🔥 CRÍTICO: Sincroniza o Prisma com o NextAuth (coleção 'sessions')
  @@map("sessions")
}

model SystemLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  action    String   
  details   String?
  createdAt DateTime @default(now())
}

// 🔥 NOVO: MODELO DE FOTOS DO MURAL (MY PHOTOS) 🔥
model PersonalPhoto {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  subtitle  String
  image     String   // Guardará a string em Base64
  createdAt DateTime @default(now())
}

model ConnectionRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId    String   @db.ObjectId
  receiverId  String   @db.ObjectId
  message     String
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt   DateTime @default(now())

  // Relacionamentos explícitos (ajuda o Prisma a entender quem é quem)
  sender      User     @relation("SentRequests", fields: [senderId], references: [id])
  receiver    User     @relation("ReceivedRequests", fields: [receiverId], references: [id])
}

model Message {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String   @db.ObjectId
  receiverId String   @db.ObjectId
  text       String
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

// 🔥 NOVO: RELAÇÃO PROFESSOR-ALUNO (Sem necessidade de aprovação do aluno)
model TeacherStudent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  teacherId  String   @db.ObjectId
  studentId  String   @db.ObjectId
  subjects   String[] @default([]) // <--- NOVO: Array de disciplinas que o aluno cursa com o professor
  createdAt  DateTime @default(now())

  teacher    User     @relation("TeacherStudents", fields: [teacherId], references: [id])
  student    User     @relation("StudentOf", fields: [studentId], references: [id])

  @@unique([teacherId, studentId])
}

// 🔥 NOVO: DOCUMENTOS DO PROFESSOR (Tarefas e Provas Gerados por IA)
model TeacherDocument {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  teacherId   String   @db.ObjectId
  title       String
  type        String   // 'informe' | 'material' | 'tarefa' | 'prova'  (Phase 2 widened from tarefa/prova)
  subject     String?
  questions   Json     // Array of { number, statement, options[], answer, type } — [] for informe/material
  headerImage String?  // Base64 institution logo
  context     String?  // Original prompt/source material
  status      String   @default("draft") // draft, published
  assignedTo  String[] @default([]) // Array of student IDs

  // 🔥 NOVO (Phase 2): anexos de informe/material + prazo
  attachmentUrl  String?
  attachmentName String?
  dueAt          DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User @relation("TeacherDocuments", fields: [teacherId], references: [id])
  submissions ExamSubmission[]
}

// 🔥 NOVO (Phase 2 — Provas gateway): submissão do aluno a uma prova/tarefa
model ExamSubmission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  documentId  String   @db.ObjectId
  studentId   String   @db.ObjectId
  answers     Json     // [{ number, answer }]
  score       Int?     // 0–100, null até corrigir
  status      String   @default("submitted") // submitted | graded
  gradedBy    String?  // 'ai' | teacherId
  feedback    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  document    TeacherDocument @relation(fields: [documentId], references: [id])
  student     User            @relation("StudentSubmissions", fields: [studentId], references: [id])

  @@unique([documentId, studentId])
  @@index([studentId])
}

model ScholarSession {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  room       String?
  query      String
  domain     String?
  status     String   @default("running") // running | done | error
  thread     Json?    // progress phases + synthesized answer
  references Json?    // Paper[] VERIFICADAS (curadas, mostradas na aba Referências)
  results    Json?    // Paper[] TODOS os descobertos/deduplicados (aba Resultados)
  evidence   Json?    // EvidenceRecord[]  (only verified shown as fact)
  insights   Json?    // { summary, trends[], contradictions[] }
  gaps       Json?    // { description, rqCards[] }  (mantido para auditoria; fora da UI desde Sugestão)
  files      Json?    // [{ name, kind, content }]   (mantido para auditoria; fora da UI desde Sugestão)
  suggestions Json?   // ForgeResponse (Suggestion Forge, porta 8003) — ver lib/scholar/types.ts
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// Cartolina (tema Caderno): o board visual de um estudo — E a memória do agente da Sala de
// Estudos (docs/HANDOFF_CARTOLINA_MEMORIA.md). `cards` é CartolinaCard[] (x/y/w/rot persistem →
// layout estável). `rev` é o contador do controle otimista: duas pessoas gravando juntas
// não se atropelam (a escrita só vale se rev bater; senão relê e reaplica a operação).
model Cartolina {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId   String   @db.ObjectId
  surface   String   // "estudos" | "lounge"
  scopeId   String?  // thread/sala — AMARRA a cartolina àquela conversa do chat
  titulo    String   @default("Estudo")
  cards     Json     // CartolinaCard[]
  rev       Int      @default(0)
  // Entra na assinatura dos links de convite: trocar o sal REVOGA todos os links já
  // enviados (sem tabela de tokens). null = nunca compartilhado.
  conviteSalt String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, surface, scopeId, updatedAt])
}

// Quem pode ver/editar a cartolina além do dono. O dono NÃO precisa de linha aqui
// (ownerId já o identifica) — papel "dono" só aparece derivado, nunca gravado por convite.
model CartolinaMembro {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  cartolinaId String   @db.ObjectId
  userId      String   @db.ObjectId
  papel       String   @default("editor") // "editor" | "leitor"
  createdAt   DateTime @default(now())

  @@unique([cartolinaId, userId])
  @@index([userId])
}

// Comentário/resposta ancorado num card (thread via parentId).
model CartolinaComentario {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  cartolinaId String   @db.ObjectId
  cardId      String   // CartolinaCard.id alvo
  userId      String   @db.ObjectId
  texto       String
  parentId    String?  @db.ObjectId
  createdAt   DateTime @default(now())

  @@index([cartolinaId, cardId, createdAt])
}

// Um turno do chat da Aura que roda no WORKER (fila "chat", CHAT_BG=1) — sair da sala
// no meio não perde a resposta: o turno conclui no servidor e fica aqui pro cliente
// reengatar (mesmo aparelho ou outro). Mesmo padrão de status do ScholarSession.
// `answer` guarda o HarnessOutput inteiro ({ mode, ... }) — não só o StructuredAnswer —
// porque o turno pode terminar como studio/research/texto, e o cliente precisa saber qual.
model ChatTurn {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  surface   String   // "estudos" | "pesquisa" (co-working da Aura)
  scopeId   String?  // threadId/spaceId da conversa (agrupa turnos)
  prompt    String
  status    String   @default("queued") // queued | running | done | error
  answer    Json?    // HarnessOutput final (mode structured → o mesmo shape do @@STRUCTURED@@)
  partial   String?  // eventos @@PROGRESS@@ acumulados enquanto roda (o cliente rederiva a fase)
  error     String?  // erro CRU (log); o cliente só vê messageForError(error)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, surface, scopeId, createdAt])
  @@index([status, updatedAt]) // reaper: presos em queued/running
}

// "Minhas coisas" da Sala de Pesquisa: o TRABALHO real do usuário (título + texto do
// editor). Diferente de ScholarSession (histórico de BUSCAS, criado a cada pesquisa) —
// só ações de pesquisa/escrita na Sala de Pesquisa criam um ResearchWork.
model ResearchWork {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String?
  content   String?
  workType  String?
  // ── TCC cross-sala (PR3, docs/HANDOFF_TCC_CROSS_SALA.md) — tudo opcional: work antigo segue igual.
  scopeId   String?  // AMARRA ao estudo/cartolina (a conversa da Sala de Estudos que criou o TCC)
  secoes    Json?    // [{ id, titulo, corpo }] — edição é POR SEÇÃO; `content` vira o espelho em markdown
  rev       Int      @default(0) // controle otimista: duas edições simultâneas não se apagam
  tccStatus String?  // "gerando" | "pronto" | "erro" (geração em background + poll)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, scopeId])
  @@map("research_works")
}

// Histórico do TCC cross-sala: TODA operação numa seção grava uma linha (origem + antes/depois).
// Última vence; o anterior fica aqui (desfazer = restaurar o `antes`). Pesquisa nasce "sugerida".
model TccRevisao {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  workId    String   @db.ObjectId
  secaoId   String
  titulo    String?  // título da seção no momento (pra timeline e pra restaurar seção removida)
  op        String   @default("substituir") // "substituir" | "inserir" | "anexar" | "remover" | "restaurar"
  origem    String   // "estudos" | "pesquisa" | "aluno"
  antes     String?  // corpo anterior (pra desfazer)
  depois    String
  status    String   @default("aplicada") // "aplicada" | "sugerida" | "rejeitada"
  fontes    Json?    // Pesquisa: [{ abnt, url?, doi? }] — fonte VERIFICADA (scholar) de cada sugestão
  nota      String?  // Pesquisa: por que a mudança (o rigor explica, não só troca)
  autorId   String   @db.ObjectId
  createdAt DateTime @default(now())

  @@index([workId, secaoId, createdAt])
  @@index([workId, status])
}

model PastResearchChat {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  researchId       String   // id estável do card (string p/ acomodar mock e real)
  scholarSessionId String?  @db.ObjectId // FK lógica p/ ScholarSession se já pesquisada
  title            String
  contextJson      Json     // snapshot: participants, agents, métricas, references, doi, downloadUrl
  messages         Json     // [{ id, role, content, createdAt, citations? }]
  pinned           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, researchId])
}

// ─── Sala de Estudos — feed "Meus Estudos" (mini-Notion) ───
model StudySpace {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String   @default("Meus Estudos")
  kind      String   @default("study") // study (Meus Estudos) | aula (canvas de criação de aula do professor)
  members   String[] @default([])   // co-autores (Lounge) — userIds com acesso de leitura/escrita
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([members])
  @@map("study_spaces")
}

model StudyItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  spaceId   String   @db.ObjectId
  type      String   // ref | insight | synthesis | base | suggestion | pdf | video | note | link | image | audio | file
  title     String   @default("")
  payload   Json?    // texto, url, videoId, pdfUrl, dataUrl, etc.
  summary   String?  // resumo generativo (Flash)
  placement String   @default("library") // "library" (biblioteca, à direita) | "feed" (no canvas central)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, spaceId])
  @@map("study_items")
}

// ─── Lounge colaborativo — documento co-criado (estudo/pesquisa/relatório) ───
// Cópia editável compartilhada: o original (StudySpace/ScholarSession) fica intacto.
// Edição em grupo acontece só no Lounge. Real-time via Pusher (canal collab-<id>).
model CollabDoc {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId    String   @db.ObjectId
  title      String   @default("Documento colaborativo")
  kind       String   @default("study")   // study | research | report
  content    String   @default("")
  members    String[] @default([])         // userIds (inclui o owner) — quem pode co-criar
  token      String   @unique              // link de convite
  sourceType String?                       // study | research (de onde foi copiado)
  sourceId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
  @@index([members])
  @@map("collab_docs")
}

// --- Verificação .edu p/ conceder o trial de estudante (/api/trial/edu/*) ---
model EduVerification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  eduEmail  String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("edu_verifications")
}

// --- Proxies gerenciados pelo admin (/api/admin/proxies) ---
model Proxy {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  label            String
  host             String
  port             Int      @default(0)
  username         String?
  password         String?
  type             String   @default("socks5")
  region           String   @default("BR")
  status           String   @default("free") // free | assigned
  assignedEmail    String?
  assignedInstance String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("proxies")
}

// --- Jobs de autonomia por voz/agente (durável; Fase autonomia) ---
model VoiceJob {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  kind      String   // research | study | write | code | schedule | summarize
  input     String
  status    String   @default("queued") // queued | running | streaming | done | error
  progress  Int      @default(0)
  result    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("voice_jobs")
}

// ─── ZAEON Studio — "formas mastigadas" geradas a partir dos estudos ───
// Cada ação do Studio (podcast, vídeo, mapa mental, linha do tempo, guia, FAQ,
// flashcards, imagem, trilha, narração) vira um StudioArtifact. Binários
// (áudio/vídeo/imagem) ficam em .studio/<id>.<storageRef> e são servidos por
// /api/studio/[id]/file; conteúdo textual/JSON (transcrição, nós do mapa,
// eventos, cards) fica em `meta`. Cache por (sourceIds + kind): o Play reusa.
model StudioArtifact {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId    String   @db.ObjectId
  sourceIds  String[] @default([])      // StudyItem/StudySpace de origem
  kind       String                      // podcast | video | mindmap | timeline | guide | faq | flashcards | image | soundtrack | narration
  status     String   @default("queued") // queued | running | done | error
  title      String   @default("")
  mime       String?                     // audio/wav, video/mp4, image/png, application/json…
  storageRef String?                     // extensão do arquivo em .studio (ex.: "wav"); null = só `meta`
  meta       Json?                       // conteúdo do artefato + opções de geração
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId, kind])
  @@index([ownerId, createdAt])
  @@map("studio_artifacts")
}

// ─────────────────────────── MEMÓRIA · L1 (transcrição durável) ───────────────────────────
// docs/MEMORY_AND_PERSISTENCE.md §2. É O ALICERCE: entrar na sala (qualquer device) e a
// conversa estar lá. Uma Conversation por (userId, surface, scopeId). Generaliza o padrão
// que o PastResearchChat já usa. Nenhum embedding aqui — restaurar = findMany por `at`.
model Conversation {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  userId    String        @db.ObjectId
  surface   String        // "estudos" | "pesquisa" | "aula" | "projetos" | "lounge"
  scopeId   String?       // studyId | researchId | projectId (a "sala concreta"); null = geral
  agentId   String?       // qual agente do roster (aura | revisor | escritor)
  title     String?
  pinned    Boolean       @default(false)
  // Cérebro (docs/HANDOFF_CEREBRO_AURA.md §2): o gatekeeper marca a conversa como estudável e
  // sugere um título; `mapaId` aponta pro MapaProbabilistico quando o aluno materializa o cérebro.
  estudavel      Boolean  @default(false)
  tituloSugerido String?
  mapaId         String?  @db.ObjectId
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, surface, scopeId])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // "user" | "assistant"
  text           String
  meta           Json?        // artifacts, studioAction, citations, provenance
  at             DateTime     @default(now())

  @@index([conversationId, at])
  @@map("chat_messages")
}

// Memória L3 (semântica) — projeção INDEXADA do L1 (docs/MEMORY_AND_PERSISTENCE.md §4.3).
// Cada drawer é VERBATIM + embedding; recall barato (ANN, sem LLM) filtrado SEMPRE por userId.
// Índice vetorial (Atlas): criar Vector Search sobre `embedding` (dims = EMBED_DIM de
// lib/agent/memory.ts = 1536, cosine, filter em userId). Owner: `npx prisma db push` + índice Atlas.
model MemoryDrawer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId // isolamento multi-tenant — SEMPRE filtrar por isto
  wingKind  String   // "usuario" | "curso" | "projeto" | "agente"
  wingLabel String
  room      String   // tópico/matéria
  kind      String   // "mensagem" | "citacao" | "artefato" | "nota"
  text      String   // VERBATIM (nunca resumido por LLM)
  sourceRef String?  // conversationId/messageId/studyId de origem (deriva do L1)
  embedding Float[]  // EMBED_DIM (1536, gemini-embedding-001) — ver lib/agent/memory.ts
  meta      Json?    // provenance
  at        DateTime @default(now())

  // curadoria + re-rank (PR-M3 · A7/A9)
  importance     Int? // peso relativo (curadoria)
  lastAccessedAt DateTime? // recency: bump a cada hit; decay no re-rank
  accessCount    Int       @default(0)
  invalidatedAt  DateTime? // SUPERSEDE: drawer aposentado → nunca entra no recall
  supersededBy   String?   @db.ObjectId // id do drawer que o substituiu

  @@index([userId, wingKind, room])
  @@index([userId, invalidatedAt])
  @@map("memory_drawers")
}

// Conector MCP (PASSO 7 · §9.11). Credenciais: SÓ `authRef` (NOME da env var) — o segredo vive
// no env/cofre, NUNCA no Mongo. `discoveredTools` = cache p/ detectar "degradado".
model Connector {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String    @unique // slug (namespaceia as tools: mcp:<name>:<tool>)
  transport        String    // "http" | "stdio"
  endpoint         String    // URL (http) ou linha de comando (stdio)
  authType         String    @default("none") // "none" | "bearer" | "header"
  authRef          String?   // NOME da env var com o segredo — nunca o segredo
  minPlan          String    @default("free")
  status           String    @default("desconectado") // desconectado|verificando|conectado|precisa_autorizar|erro|degradado
  lastCheckedAt    DateTime?
  lastError        String?
  discoveredTools  String[]  // cache dos nomes de tools (base do "degradado")
  enabledForAgents String[]  // agentes habilitados (ex.: ["aura"])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("connectors")
}

// ── MENTORES (camada agêntica; termo do produto = Mentor, não "tutor de IA") ──
// Um mentor NÃO é motor novo: é agent:"aura" (harness) parametrizado por persona de domínio
// (systemContext), memória escopada (wing = slug/userId) e skills/artefatos do domínio.
// MentorTemplate = catálogo (cópia EDITÁVEL do seed em lib/agent/mentors.ts; semeia via
// POST /api/mentors/seed ou lazy no 1º GET /api/mentors). PluggedMentor = o que o usuário plugou.
model MentorTemplate {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  slug               String   @unique // ^[a-z0-9]+(-[a-z0-9]+)*$ (ex.: "medicina", "eng-civil")
  course             String
  name               String   // codinome honorário (Osler, Noether…) — trocável
  emoji              String   @default("⟁")
  personaId          String   // = slug
  personaText        String   // texto ESPECÍFICO; a BASE comum é prefixada no runtime
  enabledSkills      String[] // literature | memory | studio | code | molecule (inexistentes degradam)
  signatureArtifacts String[]
  sources            String[]
  academicLevel      String   @default("graduacao")
  guardrail          String?  // saúde: educacional, nunca diagnóstico/prescrição/terapia (obrigatório nos 5)
  order              Int      @default(0)

  @@map("mentor_templates")
}

model PluggedMentor {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  templateId String   @db.ObjectId
  enabled    Boolean  @default(true)
  pluggedAt  DateTime @default(now())

  @@unique([userId, templateId])
  @@index([userId])
  @@map("plugged_mentors")
}

// ─── Aulas (LMS leve) — Turma é a entidade dona do vínculo professor↔alunos. ───
// FKs são ObjectId "cru" (sem @relation), como `referredBy` no User — as queries
// cruzam manualmente nas rotas (evita back-relations e não mexe no model User).
model Turma {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  professorId String   @db.ObjectId
  name        String   // "Cálculo I", "História 9ºB"…
  createdAt   DateTime @default(now())

  @@index([professorId])
  @@map("turmas")
}

model TurmaMember {     // aluno↔turma (pivot); a relação que importa
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  turmaId   String   @db.ObjectId
  studentId String   @db.ObjectId
  joinedAt  DateTime @default(now())

  @@unique([turmaId, studentId])
  @@index([studentId])
  @@map("turma_members")
}

model TurmaInvite {     // convite por token (rotulado pela turma/aula no card do chat)
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  turmaId   String    @db.ObjectId
  token     String    @unique
  label     String
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([turmaId])
  @@map("turma_invites")
}

model Aula {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  professorId String    @db.ObjectId
  turmaId     String?   @db.ObjectId         // null enquanto rascunho geral
  title       String
  body        String?                        // markdown (base generativa)
  blocks      Json?                          // sequência ordenada de blocos (fatia rica); null = aula antiga (usa body)
  youtubeIds  String[]  @default([])         // vídeos indexados
  status      String    @default("draft")    // draft | sent
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([professorId])
  @@index([turmaId])
  @@map("aulas")
}

model AulaQuiz {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  aulaId     String  @unique @db.ObjectId
  title      String
  passingPct Int     @default(70)

  @@map("aula_quizzes")
}

model AulaQuestion {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  quizId   String   @db.ObjectId
  text     String
  type     String   // choice | input | open | voice | roulette | cloze | dragwords | … (ver lib/aulas/blockTypes)
  options  Json?    // [{text,isCorrect,explanation}] (choice)
  accepted String[] @default([]) // respostas aceitas (input)
  marks    Int      @default(1)  // PONTOS do item (editável no painel de pontuação — Lote 9)
  noPaste  Boolean  @default(false) // resposta escrita: bloqueia colar (anti-cola casual)
  config   Json?    // dados específicos do módulo (roleta pool/rounds, cloze, dragwords, memória, ramificado)
  order    Int

  @@index([quizId])
  @@map("aula_questions")
}

model AulaQuizSubmission {   // tentativa + nota (assertividade)
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  quizId     String   @db.ObjectId
  studentId  String   @db.ObjectId
  percentage Float
  passed     Boolean
  answers    Json     // [{questionId, answer, audioUrl?, transcript?, isCorrect, marks, marksOutOf}]
  createdAt  DateTime @default(now())

  @@index([quizId])
  @@index([studentId])
  @@map("aula_quiz_submissions")
}

model AulaProgress {        // progresso/completude por aluno por aula
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  aulaId    String   @db.ObjectId
  studentId String   @db.ObjectId
  status    String   @default("new") // new | in_progress | completed
  readingMs Int      @default(0)     // tempo de leitura (modo foco)
  updatedAt DateTime @updatedAt

  @@unique([aulaId, studentId])
  @@index([studentId])
  @@map("aula_progress")
}
// ─── Mentor no WhatsApp (docs/WHATSAPP_MENTOR.md) ───
// Vínculo número↔usuário feito por QR `wa.me` + código CONECTAR-XXXX (NÃO pareia a conta do
// aluno). optIn = consentimento (o envio do código); "PARE" desliga. quietHours = não incomodar.
model WhatsAppLink {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @unique @db.ObjectId
  phone        String?                     // E.164 (+55…); null até o aluno mandar o código
  verified     Boolean   @default(false)
  optIn        Boolean   @default(false)
  verifyCode   String?                     // código one-time do QR (CONECTAR-XXXX)
  codeIssuedAt DateTime?
  quietHours   Json?                       // { start: 22, end: 7, tz: "America/Sao_Paulo" }
  linkedAt     DateTime?
  lastMsgAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([phone])
  @@index([verifyCode])
  @@map("whatsapp_links")
}

// Auditoria + idempotência dos disparos (dedupeKey: "agenda:2026-09-09", "deadline:<docId>"…).
model WhatsAppMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  dir       String   // "in" | "out"
  kind      String   // chat | connect | stop | resume | agenda | review | deadline | tree | credential | test
  text      String
  dedupeKey String?
  at        DateTime @default(now())

  @@index([userId, at])
  @@index([userId, dedupeKey])
  @@map("whatsapp_messages")
}
// ─── Credenciais soulbound (Solana) — toda conquista vira prova verificável do aluno ───
// Emitidas via Crossmint (wallet custodial por e-mail, gasless) como cNFT soulbound (Bubblegum V2)
// ou token-2022 non-transferable (alto valor: certificação de mentor). Leitura on-chain via Helius DAS.
// A conquista do aluno NUNCA depende do mint: falha → status "error" e o app segue (degrada).
model Credential {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String    @db.ObjectId
  type              String                        // "skill" | "work" | "mentor-cert" | "course"
  refId             String                        // nodeId/researchWorkId/aulaId/mentorCertId de origem
  title             String
  chain             String    @default("solana")
  standard          String                        // "cnft" | "token2022-nt"
  network           String    @default("devnet")  // devnet no hackathon; mainnet depois (só env)
  assetId           String?                       // id on-chain (cNFT assetId / mint)
  mintTx            String?
  crossmintId       String?                       // id do NFT na Crossmint (GET /nfts/{id} p/ polling)
  crossmintActionId String?                       // actionId da Crossmint (polling alternativo)
  walletAddress     String?                       // wallet custodial do aluno (Crossmint)
  status            String    @default("pending") // pending | minting | issued | error
  error             String?                       // última mensagem de erro (diagnóstico)
  metadata          Json?                         // trilha de evidência (provenance do harness)
  issuedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, type, refId])                 // idempotente: não cunha 2× a mesma conquista
  @@index([userId])
  @@index([status])
  @@map("credentials")
}

// ─── Árvore de Habilidades GENERATIVA (ver lib/skilltree/*) ────────────────────
// 1 árvore por tópico (cache global, reusável por todos os usuários); o progresso é por usuário.
model SkillTree {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  topicSlug  String   @unique          // normalizado do tópico ("fotossintese")
  topicLabel String
  nodes      Json                      // SkillNode[]: {id,title,branch,level,prereqs[],summary}
  model      String                    // modelo/versão que gerou (provenance)
  createdAt  DateTime @default(now())

  @@map("skill_trees")
}

model SkillProgress {                  // progresso POR usuário e nó
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  topicSlug String
  nodeId    String
  mastery   Float    @default(0)       // 0..1
  status    String   @default("locked") // locked|available|in_progress|mastered
  updatedAt DateTime @updatedAt

  @@unique([userId, topicSlug, nodeId])
  @@index([userId, topicSlug])
  @@map("skill_progress")
}

// ─── Escritório coworking (canal humano+agente) + gateway de agentes (ver lib/canal/*, lib/agents/roster.ts) ───
// AgentProfile = identidade EDITÁVEL de um agente (persona do roster OU mentor do catálogo).
// O "cérebro" continua sendo lib/ai/personas.ts / MentorTemplate; aqui só mora nome/avatar/bio.
model AgentProfile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  agentKey  String   @unique                 // = persona.id ("aura") OU mentor.slug ("medicina")
  tipo      String                           // "persona" | "mentor"
  nome      String                           // nome de exibição (default = do roster)
  avatarUrl String?                          // foto editável (landing + chat); data URL ou https
  bio       String?                          // tagline curta editável
  ativo     Boolean  @default(true)
  ordem     Int      @default(0)
  // CRACHÁ (landing + Assistentes), editável no Modo CEO → Agents
  area      String?                          // rótulo do crachá ("Pesquisa", "Medicina")
  entrega   String[] @default([])            // chips "o que entrega" (máx. 4)
  emoji     String?                          // fallback da foto
  whatsapp  String?                          // +5511999999999 (vira wa.me)
  instagram String?                          // handle, sem @
  facebook  String?                          // slug da página
  tetoTokensDia Int?                         // PR-A3: teto diário de tokens (ledger). null = sem teto. Só AGE com AGENT_TETO_ENFORCE=1 e origem "autonomo"
  updatedAt DateTime @updatedAt

  @@map("agent_profiles")
}

/// Canal de saída de um agente (WhatsApp hoje; e-mail no PR-W5). O chip é da ChipFlow:
/// `chipflowId` = WarmerInstance.id (define o shard do bridge). Referência externa, não chave.
/// Spec: docs/HANDOFF_AGENTE_MENSAGEIRO_V3.md §3 PR-W1.
model AgentChannel {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  agentKey            String                          // → AgentProfile.agentKey / roster
  tipo                String                          // "whatsapp" | "email"
  origem              String    @default("chipflow")  // "chipflow" | "proprio" | "log"
  chipflowId          Int?                            // WarmerInstance.id na ChipFlow
  chipflowToken       String?                         // 🔒 evo_token (não usado no bridge; guardado pro diretório/HTTP)
  tokenAtualizadoEm   DateTime?
  numero              String?                         // E.164 informativo — a ChipFlow é dona do número
  ownerEmail          String?
  pool                String?                         // "operator" | "owner"
  tierReportado       String?
  mensagensReportadas Int?
  apiVersion          String?
  proxyInfo           Json?
  estado              String    @default("nao_vinculado") // nao_vinculado | vinculado | pausado_na_origem | restrito | erro
  limiteDia           Int       @default(20)          // teto local (tier critical); governança real no PR-W3
  enviadosHoje        Int       @default(0)
  diaContagem         String?                         // YYYY-MM-DD (BRT) a que enviadosHoje se refere
  ultimoEnvioEm       DateTime?
  ultimoErro          String?
  sincronizadoEm      DateTime?
  email               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([agentKey, tipo])
  @@index([estado])
  @@index([chipflowId])
  @@map("agent_channels")
}

// Avatar vivo gerado no ADMIN (Etapa B): um quadro por (agente, estado, tamanho). Os sets da
// Etapa A ficam em public/avatars (build); este sobrepõe. tamanho: "g" (512) | "p" (160) |
// "base" (1024, só estado "base" — pra rerolar expressões depois sem trocar o personagem).
model AgentAvatarQuadro {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  agentKey  String
  estado    String
  tamanho   String
  mime      String   @default("image/webp")
  dados     Bytes
  versao    String
  cor       String?
  updatedAt DateTime @updatedAt

  @@unique([agentKey, estado, tamanho])
  @@index([agentKey])
  @@map("agent_avatar_quadros")
}

// Quem usa qual agente (card founder). Incremento idempotente por (agentKey,userId).
model AgentUsage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  agentKey  String
  userId    String   @db.ObjectId
  contagem  Int      @default(0)
  ultimoUso DateTime @default(now())

  @@unique([agentKey, userId])
  @@index([agentKey, ultimoUso])
  @@map("agent_usage")
}

// Canal = sala de coworking (projeto/turma). `acesso` é o author gate (quem o agente atende).
model Canal {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String   @db.ObjectId
  titulo      String
  acesso      String   @default("turma")   // "privado" | "turma" | "aberto"
  membros     String[] @default([])        // userIds (turma = via convite/adição do dono)
  agentes     String[] @default([])        // agentKeys presentes no canal
  cartolinaId String?  @db.ObjectId        // quadro compartilhado (PR da cartolina)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@map("canais")
}

model CanalMensagem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  canalId   String   @db.ObjectId
  autorTipo String                           // "humano" | "agente"
  autorId   String                           // userId OU agentKey
  texto     String
  mencoes   String[] @default([])            // agentKeys mencionados (@)
  createdAt DateTime @default(now())

  @@index([canalId, createdAt])
  @@map("canal_mensagens")
}

// ─── AURA: a economia de reputação (ver lib/aura/*) ───────────────────────────────
// ─────────────────────────── CÉREBRO · grafo de conhecimento por estudo ───────────────────────────
// docs/HANDOFF_CEREBRO_AURA.md. Um estudo (scopeId) = UM grafo = o cérebro. É a FONTE ÚNICA de
// memória do estudo: a cartolina, o visor e os artefatos são PROJEÇÕES dele (card.id === nó.id).
// `nos`/`arestas` são Json (MapaNo[]/MapaAresta[], lib/map/tipos.ts); `rev` = controle otimista.
model MapaProbabilistico {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId   String   @db.ObjectId
  surface   String   // "estudos" | "pesquisa"
  scopeId   String   // a conversa/estudo (mesmo scope da Cartolina e da Conversation)
  titulo    String   @default("Estudo")
  // Passo 0 do generateMap (§4): arquétipo + objetivo delimitado + como se conclui.
  tipoTopico        String @default("exploratorio") // aplicavel|habilidade|conceitual|exploratorio|criativo
  objetivo          String @default("")
  modoValidacao     String @default("nenhuma")      // humana|rubrica|quiz|peer|cobertura|nenhuma
  criterioCompletude String @default("")
  nos       Json     // MapaNo[]
  arestas   Json     // MapaAresta[]
  backbone  String[] // ids de nós ordenados = o percurso (vazio até o chain worker gerar)
  completudeAprendizado Float @default(0)
  completudeConclusao   Float @default(0)
  rev       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, surface, scopeId])
  @@index([ownerId, surface, updatedAt])
  @@map("mapas_probabilisticos")
}

// Validação HUMANA de um nó do cérebro (modoValidacao "humana", §5): o aluno aplica com evidência,
// o professor/instituição vinculado aprova/rejeita. Aprovar → nó `validado` + AURA + atestado.
model MapaValidacao {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  mapaId       String   @db.ObjectId
  noId         String
  alunoId      String   @db.ObjectId
  validadorId  String   @db.ObjectId
  role         String   // teacher | instituicao
  evidencia    String?
  status       String   @default("pendente") // pendente | aprovada | rejeitada
  comentario   String?
  credentialId String?  @db.ObjectId          // Credential Solana (atestado) cunhada ao aprovar
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([mapaId, noId, validadorId])
  @@index([mapaId, noId, status])
  @@index([validadorId, status, createdAt])
  @@index([alunoId, status])
  @@map("mapa_validacoes")
}

// Livro-razão append-only: cada conquista VERIFICADA vira um evento; o saldo é a soma
// (cache em User.aura). Nunca escrito pelo cliente nem por "atividade" — só por transições
// que já existem no banco (nós do mapa, credenciais). Reversão = evento negativo.
model AuraEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  source    String   // node_learned | node_applied | node_validated | brain_completed | credential_verified | edu_link | legacy_xp | reversal
  refId     String   // nodeId / `${mapaId}:${noId}` / mapaId / credentialId / userId — a chave da conquista
  amount    Int      // AURA concedida (negativa em reversal); regra em lib/aura/rules.ts
  reason    String?  // legível ("Validação: Análise de Solo — Laudo")
  createdAt DateTime @default(now())

  @@unique([userId, source, refId])   // IDEMPOTENTE: a mesma conquista nunca paga 2×
  @@index([userId, createdAt])
  @@map("aura_events")
}

// Credencial ACADÊMICA comprovada por documento (diploma/título). Declarar sem provar = 0 AURA.
// O documento é dado sensível: `docRef` só sai pela rota guardada (dono + verificador).
model AcademicCredential {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  nivel        String    // tecnico | graduacao | especializacao | mestrado | doutorado | posdoc
  area         String?   // ex.: "Agronomia"
  instituicao  String?
  docRef       String?   // conteúdo PRIVADO do documento (data URL) — NUNCA em rota pública
  docHash      String?   // sha256 do documento (detecta o mesmo diploma em contas diferentes)
  metodo       String    @default("declarado") // declarado | edu_email | doc_review | registry | onchain
  status       String    @default("pendente")  // pendente | verificado | rejeitado
  verifiedById String?   @db.ObjectId          // professor/instituição que chancelou
  verifiedAt   DateTime?
  credentialId String?   @db.ObjectId          // Credential Solana cunhada (parede de provas)
  auraEventId  String?   @db.ObjectId          // AuraEvent gerado ao verificar
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, nivel])
  @@index([docHash])
  @@map("academic_credentials")
}

// ── Contrato C5 (Fatia 1, PR-A1): TokenLedger — uma linha por chamada de LLM. Escrita BEST-EFFORT
// (lib/llm/ledger.ts; TOKEN_LEDGER="0" desliga). `cached` à parte (≈10% do prompt), nunca somado
// como token cheio; `estimatedCostUsd` = ESTIMATIVA pela tabela lib/ai/preco.ts, não fatura.
model TokenLedger {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  at               DateTime @default(now())
  userId           String?  @db.ObjectId
  agentKey         String
  mentorSlug       String?
  surface          String
  scopeId          String?
  programId        String?  @db.ObjectId
  taskId           String?  @db.ObjectId
  phase            String?
  model            String
  provedor         String                    // "vertex" | "litellm"
  rota             String                    // "vertex" | "gateway"
  alvo             String?                   // provedor upstream (Fatia 7); null = vertex
  promptTokens     Int      @default(0)      // NÃO cacheado
  completionTokens Int      @default(0)
  cachedTokens     Int      @default(0)
  totalTokens      Int      @default(0)
  reportado        Boolean  @default(true)   // false = provedor não devolveu usage (zeros, não inventados)
  jsonValido       Boolean?
  estimatedCostUsd Float    @default(0)      // ESTIMATIVA (lib/ai/preco.ts), não fatura; cached cobrado à parte
  ok               Boolean  @default(true)
  erro             String?                   // classe do erro quando ok=false
  ms               Int      @default(0)

  @@index([agentKey, at])
  @@index([userId, at])
  @@index([programId, at])
  @@index([at])
  @@map("token_ledger")
}

// ── Contrato C8 (Fatia 7, PR-G5): AgentChore — tarefa PEQUENA de agente (checar página, resumir
// link, extrair campos…) rodando no pool grátis quando o conteúdo é público (lib/chore/*).
// `destino` e `tipo` são FIXADOS na criação (plan-then-execute): nada lido depois — nem do modelo,
// nem do conteúdo — muda onde/como a chore age. Flag CHORES_QUEUE; sem ela nenhuma chore existe.
model AgentChore {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  tipo           String                       // checar_pagina | feed_novos | resumir_link | classificar_anexo | extrair_campos | digest | link_rot | formatar_abnt | traduzir_trecho
  agentKey       String
  requesterId    String?  @db.ObjectId        // null = autônoma (P3, fatia 8)
  canalId        String?  @db.ObjectId
  alvo           Json                         // O QUE LER: {url?, urls?, feedUrl?, anexoId?, texto?, campos?, classes?, referencia?, de?, para?}
  destino        Json                         // ONDE/COMO AGIR — FIXADO NA CRIAÇÃO: {canalId, parentId: string|null, modo: "thread" | "digest" | "silencioso"}
  origemConteudo String                       // "web" | "anexo" | "canal" → rotaDaChore(): web = pool via gateway; anexo|canal = vertex (§8.10)
  status         String   @default("queued")  // queued | running | delayed | done | skipped | failed | expired
  resultado      Json?                        // {texto?, campos?, classe?, diff?, itens?, fonteUrl, lidoEm, modelo, provedor, alvo, bytes}
  cursor         String?                      // cursor desta passada (hash do texto normalizado | etag | lastModified)
  motivo         String?                      // skipped: "sem_mudanca" · failed: ClasseErroLlm | code da tool · expired: "pool_esgotado_expirado"
  chamadasLlm    Int      @default(0)         // ≤ 3
  ms             Int      @default(0)
  jobId          String   @unique             // chore:<tipo>:<sha256(alvo canônico)[:12]>:<YYYY-MM-DD>
  expiraEm       DateTime                     // createdAt + 24h
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([agentKey, createdAt])
  @@index([status, updatedAt])
  @@index([canalId, createdAt])
  @@index([tipo, createdAt])
  @@map("agent_chores")
}

// "Registra que checou" (lei 6) — 1 linha por fonte; diff vazio = não fala e não gasta, mas conta aqui.
model ChoreCursor {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  fonteHash        String   @unique            // sha256(tipo + alvo canônico)
  tipo             String
  ultimoCursor     String?
  ultimaChecagemEm DateTime @default(now())
  ultimaMudancaEm  DateTime?
  checagens        Int      @default(0)
  mudancas         Int      @default(0)

  @@map("chore_cursors")
}

// --- FROTA DE IAs DO CYBERESPAÇO (lib/cyber/frota) ---
/// o texto de um episódio de conversa entre IAs (gerado na 1ª vez que alguém vê — o mesmo pra todos)
model FrotaConversa {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  epId      String   @unique
  /// as falas na ordem (null = fala em MODO CLOAK, que só aparece como "...")
  falas     Json
  criadoEm  DateTime @default(now())
  @@map("frota_conversas")
}
/// a "impressão" (normalizada) de toda fala de IA que um usuário pôde ver — a regra de ouro: nada se repete
model FrotaFala {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  impressao  String   @unique
  criadoEm   DateTime @default(now())
  @@map("frota_falas")
}

/// CORRIDAS de moto (lib/cyber/corrida): cada corrida terminada — o ranking de cada pista é o melhor `ms` de cada usuário
model CorridaTempo {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  pista    String
  userId   String   @db.ObjectId
  nome     String
  cor      String
  ms       Int
  voltas   Int[]
  criadoEm DateTime @default(now())
  @@index([pista, ms])
  @@index([pista, userId])
  @@map("corrida_tempos")
}
