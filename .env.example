# ───────────────────────────────────────────────────────────────────────────
# Zaeon OS — variáveis de ambiente (TEMPLATE)
# Copie para `.env` (e `.env.local` no dev) e preencha. NÃO commitar os reais.
# ───────────────────────────────────────────────────────────────────────────

# ── Banco (MongoDB Atlas) ──────────────────────────────────────────────────
# Prisma usa DATABASE_URL; o código (Mongoose) usa MONGODB_URI. Aponte os dois
# para a MESMA connection string do Atlas.
DATABASE_URL="mongodb+srv://USER:PASS@cluster.mongodb.net/zaeon?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://USER:PASS@cluster.mongodb.net/zaeon?retryWrites=true&w=majority"

# ── Auth (NextAuth) ────────────────────────────────────────────────────────
# Endereço público do app. TEM que bater com o redirect URI do client Google, senão o
# login autentica e devolve o usuário no vazio. Em produção quem manda é a Variable
# APP_URL do repo (deploy.yml → NEXTAUTH_URL no compose).
NEXTAUTH_URL="https://75-119-140-97.sslip.io"
NEXTAUTH_SECRET="gerar-com: openssl rand -base64 32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Convites de CADASTRO (a porta fechada). Hoje o cadastro é aberto: quem chega entra com
# e-mail ou Google. O fluxo de convite continua inteiro no código — página, cards, código,
# pending_registrations — só que desligado. Para reabrir a porta fechada: "1".
# Não afeta convite de TURMA (/join/[token]) nem de COLABORAÇÃO (/c/[token]).
NEXT_PUBLIC_CONVITES_ATIVOS=""

# ── IA (Vertex / Gemini = IA principal) ────────────────────────────────────
GOOGLE_PROJECT_ID=""
GOOGLE_LOCATION="us-central1"
# Location só do Gemini TEXTO (chat, cache de PDF, agentes, Scholar, gateway). "global" espalha a cota
# (us-central1 dava 429 no pico) e é onde o gemini-3.5-flash existe neste projeto. Imagem/TTS/Imagen
# ficam no GOOGLE_LOCATION. Vazio = GOOGLE_LOCATION (rollback = apagar a linha). Ver lib/ai/vertex-credentials.ts.
GEMINI_TEXT_LOCATION=""
# Credencial de service account: JSON inteiro OU email+chave separados.
GOOGLE_CREDENTIALS=""
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_MODEL_FLASH="gemini-2.5-flash"
GEMINI_MODEL_PRO="gemini-2.5-pro"
SCHOLAR_GEMINI_MODEL=""            # vazio = segue o GEMINI_MODEL (antes ficava fixo no 2.5-flash)
SCHOLAR_GEMINI_CHAT_MODEL="gemini-2.5-flash"

# ── Anthropic (opcional / sala Projetos) ───────────────────────────────────
# Por padrão a IA é só Gemini. Deixe vazio se não usar Claude nos Projetos.
ANTHROPIC_API_KEY=""
ANTHROPIC_SONNET_MODEL=""
ANTHROPIC_OPUS_MODEL=""
PROJECTS_ANTHROPIC="off"

# ── Cache / Rate-limit (Upstash Redis REST) ────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Motor de voz neural (FastAPI; ver voice-engine/) ───────────────────────
VOICE_ENGINE_URL="http://localhost:8004"

# ── Microserviços de pesquisa (Omega Scholar) ─────────────────────────────
ABNT_SERVICE_URL=""
QUALITY_ENGINE_URL=""
SUGGESTION_FORGE_URL=""
OMEGA_SCHOLAR_PATH=""
SEMANTIC_SCHOLAR_API_KEY=""
UNPAYWALL_EMAIL=""

# ── YouTube (aba Vídeos da Sala de Estudos) ────────────────────────────────
YOUTUBE_API_KEY=""

# ── Sala Projetos: GitHub App + OAuth ──────────────────────────────────────
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_INSTALLATION_ID=""
GITHUB_APP_CALLBACK_URL="https://zaeon.com.br/api/projects/github/callback"   # igual à Callback URL do GitHub App e ao host do NEXTAUTH_URL
# Chave para criptografar tokens OAuth no banco (AES-GCM). 32 bytes em hex (openssl rand -hex 32) ou base64.
# OBRIGATÓRIA em produção: sem ela publicar/conectar GitHub falha fechado (sem fallback NEXTAUTH_SECRET). Trocar invalida os tokens salvos.
TOKEN_ENC_KEY="gerar-com: openssl rand -hex 32"
# Gate da sala Projetos por curso. "off" libera todos (super admin/plano sempre passam).
PROJECTS_COURSE_GATE="on"

# ── Deploy de projetos (Vercel) — opcional ─────────────────────────────────
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""

# ── Realtime alternativo (Pusher) — opcional ───────────────────────────────
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ── IPFS (Pinata) — opcional ───────────────────────────────────────────────
NEXT_PUBLIC_PINATA_JWT=""

# ── Credenciais soulbound na Solana (Crossmint + Helius) — opcional ────────
# Sem estas chaves a camada DEGRADA: a conquista do aluno segue e a Credential fica "error".
# devnet = Crossmint STAGING (staging.crossmint.com) + Helius devnet. mainnet = só troca env/keys.
SOLANA_NETWORK="devnet"
# Server-side API key da Crossmint (console → API keys → server, scopes nfts.create + nfts.read).
CROSSMINT_SERVER_KEY=""
# Coleção Solana (Bubblegum cNFT) da Crossmint — credenciais comuns (skill/work/course).
CROSSMINT_COLLECTION_ID=""
# (Opcional) coleção token-2022 non-transferable p/ certificação de mentor (alto valor).
# Vazio → usa CROSSMINT_COLLECTION_ID com mint não comprimido.
CROSSMINT_COLLECTION_ID_NT=""
# Helius (DAS API) — leitura on-chain do mural / prova de posse. Vazio → mural sem selo "verificada".
HELIUS_API_KEY=""

# ── Núcleo interno ─────────────────────────────────────────────────────────
CORE_API_KEY=""

# ── Flags / runtime ────────────────────────────────────────────────────────
# Modo de runtime: "container" (VPS persistente — voz neural no servidor, RAG pesado,
# Gemini com thinking e teto de tokens maior) ou "vercel" (modo leve/serverless).
# No VPS use container. Default do código já é container.
NEXT_PUBLIC_RUNTIME_MODE="container"
# Overrides finos (opcionais) — cada um aceita on/off e sobrepõe o default do modo:
#   NEXT_PUBLIC_TTS_SERVER="on"   # voz neural (Kokoro) no servidor
#   NEXT_PUBLIC_HEAVY_RAG="on"    # análise de PDF inteiro (RAG pesado)
#   NEXT_PUBLIC_WHATSAPP="off"    # só ligar quando o backend do WhatsApp existir
NEXT_PUBLIC_FEATURE_PAST_RESEARCH_CHAT="on"
# Admin supremo por env (além dos fundadores no código). Sua conta entra sem convite e
# com todos os poderes. Aceita 1 ou várias separadas por vírgula. Ex.: "voce@gmail.com".
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=""
PORT="3000"

# ── Mentor no WhatsApp (docs/WHATSAPP_MENTOR.md) ───────────────────────────
# Número da PLATAFORMA (E.164). O QR do perfil é wa.me deste número com CONECTAR-<código>.
WHATSAPP_PLATFORM_PHONE=""
# Segredo do inbound (/api/whatsapp/webhook): header x-whatsapp-secret OU ?token=. Obrigatório.
WHATSAPP_WEBHOOK_SECRET="gerar-com: openssl rand -hex 24"
# Token das rotas internas (/api/whatsapp/send e /dispatch) + tick do scheduler (server.js).
WHATSAPP_INTERNAL_TOKEN="gerar-com: openssl rand -hex 24"
# Sender de saída: "bridge" (chip da ChipFlow via Redis Streams wa:cmd/wa:evt) | "evolution"
# (instância única no Evolution API) | "disparos" (legado, ver handoff v3 §8) | "log".
WHATSAPP_PROVIDER="log"
# Bridge (handoff v3 §1.2). NUNCA cai no REDIS_URL — ele é o broker do BullMQ e não tem wa:evt.
CHIPFLOW_BRIDGE_REDIS_URL=""     # 🔒 Redis do adapter da ChipFlow (dono das sessões aquecidas)
BRIDGE_REDIS_URL=""              # alternativa: bridge próprio
NUM_SHARDS="1"                   # tem de bater com warmer e adapter
BRIDGE_INSTANCE_ID=""            # fallback: chipflowId único quando o agente não tem AgentChannel
BRIDGE_TIMEOUT_MS="30000"        # espera pelo evento terminal
EVOLUTION_URL=""              # ex.: http://evolution:8080 (perfil whatsapp do compose)
EVOLUTION_INSTANCE=""         # nome da instância única da plataforma
EVOLUTION_API_KEY=""          # AUTHENTICATION_API_KEY do Evolution
DISPAROS_URL=""               # ex.: http://disparos:8080 (repo de disparos/ChipFlow)
DISPAROS_API_KEY=""
DISPAROS_SEND_PATH="/api/send"   # ⚠️ confirmar contra a API real do repo de disparos
# Gate: WhatsApp = Plus. "1" abre pra todos (decisão do dono).
WHATSAPP_OPEN_TO_ALL="0"
# Scheduler dos disparos (server.js): a cada N min; "0" em WHATSAPP_DISPATCH desliga.
WHATSAPP_DISPATCH_EVERY_MIN="15"
WHATSAPP_DISPATCH="1"

# ── Infra do compose (agent-gateway) ───────────────────────────────────────
POSTGRES_PASSWORD="trocar-em-producao"
GRAFANA_PASSWORD="trocar-em-producao"

# ── Proxy/HTTPS (Caddy) ────────────────────────────────────────────────────
# Hostnames que o Caddy serve, separados por vírgula (SEM espaço). Todos precisam ter
# A record apontando pra VPS: 75.119.140.97. O endereço provisório (sslip.io) fica na
# lista de propósito — enquanto o DNS do domínio novo propaga, o site continua no ar.
# Em produção quem manda é o deploy.yml (env BETA_DOMAIN / Variable do repo).
BETA_DOMAIN="zaeon.com.br,www.zaeon.com.br,75-119-140-97.sslip.io"
ACME_EMAIL="admin@zaeon.space"

# ── Cartolina (coworking / memória da Sala de Estudos) — tudo OFF por padrão ──
# CARTOLINA_MEMORIA=1              # liga /api/cartolina* (rodar `prisma db push` antes)
# NEXT_PUBLIC_CARTOLINA_MEMORIA=1  # UI carrega/salva o board real (valor de BUILD)
# CARTOLINA_COWORK=1               # reservada: compartilhar/comentar (PR seguinte)

# ── TCC cross-sala (Estudos cria/edita · Pesquisa lapida) — OFF por padrão ──
# TCC_CROSS=1                      # liga /api/tcc* e o "crie um TCC" no chat (rodar `prisma db push` antes)
# NEXT_PUBLIC_TCC_CROSS=1          # UI: aba TCC na Sala de Estudos + sugestões na Pesquisa (valor de BUILD)
#                                  # o card do TCC na cartolina precisa também de CARTOLINA_MEMORIA=1
# CHAT ÚNICO — a Sala de Pesquisa vira o "Modo pesquisa" do chat da Aura; vários trabalhos por conversa no editor
# NEXT_PUBLIC_CHAT_UNICO=1         # UI (valor de BUILD: build-arg no Dockerfile/compose/deploy.yml)
# CHAT_UNICO=1                     # servidor: liga o motor dos trabalhos (/api/tcc*) sem precisar do TCC_CROSS (rodar `prisma db push` antes)
# BLUEPRINT PRÁTICO (Sala de Estudos — lib/blueprint; depende de ESTUDO_GATEKEEPER=1 pra criar os estudos):
# NEXT_PUBLIC_BLUEPRINT_PRATICO=1  # UI: a aba "Sala de Estudos" vira o blueprint (valor de BUILD)
# BLUEPRINT_PRATICO=1              # servidor: conversa estudável cria/recompõe o blueprint + rotas /api/blueprint
# GITHUB_TOKEN=                    # opcional, só leitura pública: busca de repositórios do tema sem o limite de ~10/min
# VÍDEO DO DOCUMENTO (lib/videodoc — depende do blueprint ligado): os documentos-base ganham vídeo com a Zaeon holograma
# NEXT_PUBLIC_VIDEO_DOC=1          # UI: card de vídeo na prancha + player (valor de BUILD)
# VIDEO_DOC=1                      # servidor: gera (Gemini + Gemini TTS, fila de 2, 6/pessoa/dia) e abre /api/videodoc
# CARTOLINA_COWORK=1               # compartilhar/entrar/comentar (exige CARTOLINA_MEMORIA)
# NEXT_PUBLIC_CARTOLINA_COWORK=1   # UI do coworking (valor de BUILD)
# CADERNO_ENABLED=1                # prancha LLM→SVG (+ fallback Imagen)
# NEXT_PUBLIC_CADERNO_ENABLED=1    # botão "desenhar com a Aura" (valor de BUILD)

# ── App mobile (/m) — OFF por padrão ──
# NEXT_PUBLIC_MOBILE_UI=1          # liga /m; no celular as salas abrem em /m por padrão ('versão completa' sai) (valor de BUILD)
# ── Projetos / Zaeon Code — ESCONDIDO por padrão (código intacto) ──
# NEXT_PUBLIC_PROJETOS=1           # reexibe a aba Projetos, a Plugin Store do Zaeon Code e as ferramentas da Aura (valor de BUILD)
# ── Chat da Aura retomável (Fase 3) — OFF por padrão ──
# CHAT_BG=1                        # turno da Aura na fila "chat" (SÓ com o worker de pé)
# CHAT_WORKER_CONCURRENCY=4        # no worker


# ─── Escritório coworking (canal humano+agente) · gateway de agentes · avatares — TODAS off por padrão ───
NEXT_PUBLIC_UNIFIED_RESEARCH_ROOM=""   # "1" → Sala de Pesquisa unificada (sub-abas Chat·Estudos·Pesquisas; sem Sala de Estudos/toggle TCC). BUILD-ARG.
NEXT_PUBLIC_ESCRITORIO_COWORK=""   # "1" → aba "escritorio" vira o canal em tempo real (sem 3D) + rotas /api/canal
NEXT_PUBLIC_AGENTS_ADMIN=""        # "1" → aba "Agents" no admin (founder) + rotas /api/admin/agents
NEXT_PUBLIC_AGENT_AVATARS=""       # "1" → landing/loja leem avatar do AgentProfile (/api/agents/public)
CANAL_QUEUE=""                     # "1" (+ REDIS_URL) → turnos de agente via BullMQ "canal-turnos"; vazio = inline no web
CANAL_WORKER=""                    # "1" no processo worker → consome a fila canal-turnos (instrumentation.ts)
# ─── Gateway de LLM / chave única (Fatia 1: PR-G1/A1/G2/A3) — TUDO off por padrão ───
GATEWAY_URL=""                     # endpoint do LiteLLM (ex.: http://litellm:4000). Vazio = Vertex direto. Só o turno do canal opta.
GATEWAY_MASTER_KEY=""              # 🔒 master key do LiteLLM (sem ela o container não sobe). Nunca no git.
LITELLM_DATABASE_URL=""            # 🔒 postgresql://litellm:<LITELLM_PG_PASSWORD>@litellm-db:5432/litellm
LITELLM_PG_PASSWORD=""             # 🔒 senha do Postgres do gateway (perfil gateway)
LITELLM_IMAGE_TAG=""                # vazio = v1.103.4 (fixada no compose). Nunca "main-stable" (quebrou /key/generate em 2026-10-07)
LITELLM_SALT_KEY=""                # 🔒 salt das keys no banco do LiteLLM (gerar 1x; trocar = perder as keys)

# Gateway LOCAL da Zaeon (Contabo: LiteLLM → Ollama/TEI, só na tailnet). Ver docs/RUNBOOK_MODELOS_CONTABO.md.
# Gateway da VPS → modelos da Contabo (grupos zaeon-local-* em infra/litellm.config.yaml), pela tailnet.
CONTABO_LLM_URL=""                 # http://<IP Tailscale da Contabo>:4000 (SEM /v1 — o litellm_proxy/ monta)
CONTABO_LLM_KEY=""                 # 🔒 virtual key gateway-vps do LiteLLM da Contabo
LOCAL_LLM_URL=""                   # http://<IP Tailscale da Contabo>:4000/v1/chat/completions. Vazio = desligado.
LOCAL_LLM_KEY=""                   # 🔒 master key OU virtual key do LiteLLM da Contabo
LOCAL_LLM_MODEL=""                 # vazio = gpt-oss-20b (nome lógico do infra/zaeon-models/litellm-config.yaml)
LOCAL_LLM_TIMEOUT_MS=""            # vazio = 60000. Estourou → fallback pro roteamento normal
AI_FORCE_LOCAL=""                  # "on" = TUDO pelo gateway local (falhou → Gemini)
GATEWAY_KEY_DEFAULT=""             # 🔒 virtual key usada quando o agente não tem a sua (GATEWAY_KEY_<AGENTKEY>, PR-G2)
# Virtual key POR AGENTE (PR-G2): nome = GATEWAY_KEY_ + agentKey em MAIÚSCULO com "-"/"." → "_". Gerar com
# scripts/gateway-keys.mjs (idempotente por alias; budget diário em USD; TTL 90d). Agente sem key → GATEWAY_KEY_DEFAULT → Vertex direto.
# GATEWAY_KEY_AURA=""              # 🔒 ex.: persona "aura"
# GATEWAY_KEY_ENG_COMPUTACAO=""    # 🔒 ex.: mentor "eng-computacao"
# ─── Pool GRÁTIS do gateway (Fatia 7, PR-G3) — só chores com conteúdo PÚBLICO da web (dado de aluno nunca sai do Vertex) ───
# UMA conta por provedor e UMA key por provedor — proibido segunda key do mesmo provedor (suspensão de conta).
# Lidas pelo container litellm (env_file). Sem elas o gateway segue só-Vertex. Prova de vida: node scripts/provar-chaves.mjs
GEMINI_FREE_API_KEY=""             # 🔒 AI Studio, conta DEDICADA — nunca a do negócio (essa guarda o crédito GenAI/Vertex/OAuth)
CLOUDFLARE_ACCOUNT_ID=""           # ID da conta Cloudflare (Workers AI)
CLOUDFLARE_API_KEY=""              # 🔒 token da Cloudflare com permissão "Workers AI: Read"
GROQ_API_KEY=""                    # 🔒 Groq (free tier)
ZHIPU_API_KEY=""                   # 🔒 opcional, off (GLM comentado no infra/litellm.config.yaml)
# ─── Chores — tarefas pequenas de agente no pool grátis (Fatia 7, C8) — TUDO off por padrão ───
CHORES_QUEUE=""                    # "1" (+ REDIS_URL) → chores existem e vão pro BullMQ "agent-chores". Vazio = nenhuma chore. LIGAR POR ÚLTIMO.
CHORES_WORKER=""                   # "1" no container worker → consome "agent-chores"
CHORES_WORKER_CONCURRENCY="2"
RAG_QUEUE=""                       # "1" (+ REDIS_URL) → indexação de documentos (RAG) vai pro BullMQ "rag-index". Vazio = indexa inline em segundo plano no web.
RAG_WORKER=""                      # "1" → o PRÓPRIO processo web (instrumentation) consome "rag-index" (embeddings via Vertex); não há container worker do RAG
RAG_PG_URL=""                      # 🔒 Postgres+pgvector do RAG (Contabo, só na tailnet): postgres://rag_app:<senha>@<host-tailnet>:5432/zaeon_rag. Esquema: infra/zaeon-models/rag-schema.sql. Vazio = RAG fora do ar.
CHORE_POSTS_DIA="10"               # teto de posts de chore por canal/dia; acima disso grava e não fala
# Leitor (G6): o único caminho de chore para a internet — container leitor-proxy, SEM credencial (perfil compose "chores").
LEITOR_PROXY_URL=""                # "http://leitor-proxy:8787" com o perfil chores de pé. Vazio = Leitor fora do ar (lei 5).
LEITOR_ALLOW="*.gov.br,*.edu.br,*.scielo.br,pubmed.ncbi.nlm.nih.gov,arxiv.org,doi.org,who.int,*.wikipedia.org"   # default-deny: fora da lista o Leitor recusa (sugestão)
LEITOR_MAX_BYTES="1048576"
TOKEN_LEDGER=""                    # "0" desliga o TokenLedger (default: ligado, escrita best-effort)
AGENT_TETO_ENFORCE=""              # "1" → teto por agente DESATIVA o trabalho autônomo; vazio = só avisa no admin (PR-A3)
NEXT_PUBLIC_MENTORES_TAB=""        # "1" → /mentores + loja com "Mentores" primeiro; /plugin-store redireciona preservando a query. BUILD-ARG (PR-A2)
# ─── Avatares vivos dos agentes (docs/AVATARES_VIVOS.md) ───
# Geração (estúdio dev /dev/avatares + tool do admin): Gemini image no Vertex, mesma credencial GOOGLE_*.
AVATAR_IMAGE_MODEL=""              # default gemini-2.5-flash-image (os ids do Imagen dão 404 no projeto)
AVATAR_IMAGE_LOCATIONS=""          # vírgula; default global + 6 regiões (429 numa → tenta a próxima)
# Motor no cliente: vazio = Live2D quando o manifesto do agente tem modelo PRÓPRIO, senão sprite | "sprite" força sprites
NEXT_PUBLIC_AVATAR_ENGINE=""
NEXT_PUBLIC_LIVE2D_CORE_URL=""     # opcional: servir Cubism Core / PixiJS / pixi-live2d-display localmente
NEXT_PUBLIC_LIVE2D_PIXI_URL=""
NEXT_PUBLIC_LIVE2D_LIB_URL=""

# ─── AURA (economia de reputação: ledger AuraEvent + credencial acadêmica) — OFF por padrão ───
NEXT_PUBLIC_LOUNGE_3D=""      # "1" → aba Lounge vira sala de co-working 3D (avatares, notas, chat; ≤5 por sala). BUILD-ARG. Pusher opcional (sem ele, sem tempo real)
MAP_HARNESS=""                # "1" → rotas /api/map/*; o GRAFO (MapaProbabilistico) é a memória canônica do estudo; a cartolina vira projeção (rodar `prisma db push`)
NEXT_PUBLIC_CYBER_AVATAR_GLB=""  # URL do GLB humano rigado (Idle/Walk/Run) do cyberespaço. Vazio = modelo de referência (threejs.org/Soldier.glb); em produção, hospede um GLB próprio (ex.: /assets/avatar.glb). BUILD-ARG
NEXT_PUBLIC_CYBER_LANDMARKS=""  # marcos megalíticos do cyberespaço (Zaeon…). Vazio = ligado em dev, desligado em produção; "1" liga em prod. BUILD-ARG
CYBER_QG_EMAILS=""  # e-mail(s) do dono do QG do cyberespaço (Andrei Bacelar), separados por vírgula: a base dele fica no centro do salão do QG. Vazio = reconhece pelo nome exato "Andrei Bacelar". Só servidor (runtime)
NEXT_PUBLIC_MAP_HARNESS=""    # "1" → bolinha azul + painel do cérebro na aba Chat da Sala de Pesquisa (valor de BUILD)
ESTUDO_GATEKEEPER=""          # "1" → a cada turno decide se a conversa é estudável (heurística; modelo só na zona cinzenta)
AURA_ECONOMY=""               # "1" → rotas /api/profile/aura, /api/credentials/academic, /api/academic/*; skilltree paga AURA em vez de xp
NEXT_PUBLIC_AURA_ECONOMY=""   # "1" → cartão AURA no perfil (valor de BUILD)
WEB_SEARCH_PROVIDER=""  # searxng|tavily|brave — força o provedor da busca web (default: o 1º configurado; SearXNG sobe no compose)
TAVILY_API_KEY=""       # opcional: busca web gerenciada (alternativa/fallback ao SearXNG)
BRAVE_API_KEY=""        # opcional: idem

# ───── Octa Code — Pack Sinistro (docs/HANDOFF_OCTA_CODE_PACK.md) ─────
NEXT_PUBLIC_OCTA_CODE=""      # "1" → painel de saúde /octa/saude + POST /api/octa/evals/run. BUILD-ARG (Dockerfile/compose/deploy.yml). A IDE do Octa NÃO depende disto (Marketplace).
OCTA_VAULT_KEY=""             # 🔒 32 bytes em base64 (openssl rand -base64 32). Cifra os segredos do cofre do Octa (AES-256-GCM).
# O Octa usa o MESMO gateway da infra (GATEWAY_URL/GATEWAY_MASTER_KEY acima) e o modelo REAL do app (GEMINI_MODEL/GEMINI_MODEL_PRO).
# Turno do agente Octa (fluxo landing) em job BullMQ. Sem estas, roda inline no processo web.
OCTA_QUEUE=""                 # "1" (+ REDIS_URL) → turnos entram na fila octa-turno.
OCTA_WORKER=""                # "1" → este processo consome a fila (instrumentation.ts). Exige OCTA_QUEUE=1 e REDIS_URL.
OCTA_WORKER_CONCURRENCY=""    # turnos em paralelo por worker (padrão 2).
OCTA_CRON_SECRET=""           # 🔒 Bearer exigido por POST /api/octa/evals/run. Em prod: secret do repo → deploy.yml grava no .env.secrets; o cron é .github/workflows/octa-evals.yml (07h UTC).

# ───── Canais do mundo real (docs/PLANO_AGENTES_MUNDO_REAL.md) ─────
# Agentes da Zaeon no Instagram / X / LinkedIn. Decisão do dono ("Opção A"): UMA conta
# institucional por rede, com os agentes ASSINANDO o post — não é uma conta por agente.
# O WhatsApp NÃO entra aqui: continua por agente em `AgentChannel` (chip via ChipFlow).
# F0 = contrato + model `CanalSocial`; nenhuma rede está ligada ainda.
#   O token de cada rede NUNCA vem destas envs: `CanalSocial.tokenRef` guarda o NOME da
#   env/secret que tem o token (mesmo padrão de `Connector.authRef`).
CANAIS_EXTERNOS=""            # vazio/1 = camada ligada (default). "0" = volta a ser só WhatsApp, sem deploy.
CANAIS_AUTO_PUBLICAR=""       # "0" FORÇA aprovação humana em tudo, vencendo o opt-in de cada canal.
                              # Aprovação humana já é o default (CanalSocial.autoPublicar=false):
                              # auto-publicar é opt-in POR CANAL, nunca global.

# ───── Octa — trava de segredo (lib/octa/noPii): código sai, credencial não ─────
# Pré-requisito do HF-GPU (portão 4 do handoff): o Octa é uso interno e pode mandar o CÓDIGO do
# projeto pra provedor externo, menos `.env`, chaves, tokens e credenciais.
#   camada 1 (por caminho)  → octa_ler/octa_buscar/octa_listar recusam arquivo de segredo. Vale pra
#                             TODO provedor (Google e Contabo incluídos). `.env.example` continua
#                             liberado de propósito (o agente precisa dos NOMES das variáveis).
#   camada 2 (por conteúdo) → mensagens saem com segredos redigidos quando o destino é provedor
#                             TERCEIRO (Hugging Face); pega credencial chumbada em arquivo legítimo.
OCTA_NO_PII=""                # vazio/1 = trava LIGADA (default). "0" desliga a camada 1 sem deploy (recriar o web).
OCTA_MODELOS_TERCEIROS=""     # nomes extra que contam como provedor terceiro (vírgula). `hf-*` e `modelo:provedor` já entram sozinhos.

# ─── Busca de livros (harness: intenção buscar_livro, lib/livros/busca.ts) ───
# Opcional. Sem ela o Google Books usa a cota anônima compartilhada (estoura fácil — a busca segue nas
# outras fontes: OpenStax, Project Gutenberg, Open Library/Internet Archive). Chave grátis no Google Cloud
# (API "Books API"), restrita a essa API.
GOOGLE_BOOKS_API_KEY=""            # 🔒

# ── Reserva do chat pelo Hugging Face (lib/llm/reservaHf) ─────────────────────────────────────────
# Quando o Vertex recusa/estoura/cai/volta vazio, o mesmo pedido vai pro gpt-oss-120b (Cerebras → Groq)
# pelo router do HF. Token fine-grained com "Make calls to Inference Providers". Sem token = desligada.
HF_TOKEN=
# HF_RESERVA=0                     # desliga sem deploy
# HF_RESERVA_MODELOS=openai/gpt-oss-120b:cerebras,openai/gpt-oss-120b:groq
# HF_RESERVA_TIMEOUT_MS=45000
# DISPAROS_HF=1                    # o HF vira o caminho PRINCIPAL dos disparos da Zaeon no WhatsApp
#                                  # (agenda/revisão/lembretes/check-in). O Vertex fica como queda.
#                                  # NÃO muda o chat: a pergunta do aluno segue com o HF só na reserva.
#                                  # Com isto LIGADO o nome do aluno é pseudonimizado antes de sair
#                                  # (lib/whatsapp/zaeon/semNome) e reposto na mensagem que ele recebe.
# DISPAROS_HF_SEM_HISTORICO=1      # também corta a conversa de WhatsApp do aluno do prompt.
#                                  # Default: o histórico VAI (é o que faz a mensagem ser boa).
# Chat em background (turno salvo; conexão que cai não perde a resposta). Os dois juntos:
# CHAT_BG=1
# SCHOLAR_WORKER=1

# ── Datasets no Hugging Face (lib/hf) ─────────────────────────────────────────────────────────────────────
# Token fine-grained com escrita SÓ nos repos da org. Com os dois, o 👍/👎 do chat sobe a cada 6 h (anonimizado)
# pra <org>/zaeon-feedback-chat (privado). FEEDBACK_DATASET=0 desliga. FEEDBACK_SAL = sal do hash do aluno.
HF_DATASETS_TOKEN=
HF_DATASETS_ORG=
# FEEDBACK_SAL=

# ── Pool grátis: Cerebras (gpt-oss-120b) entre o AI Studio grátis e a reserva Google paga ────────────────
# Só conteúdo PÚBLICO (lib/llm/publico: resumo de artigo e "cruzar" artigos pelos metadados). Chave em cloud.cerebras.ai.
CEREBRAS_API_KEY=
# POOL_PUBLICO=0   # manda o resumo/cruzamento de artigos direto pro Vertex
